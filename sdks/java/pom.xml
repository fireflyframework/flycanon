<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.9</version>
    <relativePath/>
  </parent>

  <groupId>com.firefly</groupId>
  <artifactId>flycanon-sdk</artifactId>
  <version>26.10.6</version>
  <packaging>jar</packaging>

  <name>flycanon-sdk</name>
  <description>
    Spring-Boot-native Java client for the flycanon Operational
    Knowledge Repository service. Built on Spring's RestClient (sync,
    blocking; new Spring Framework 6.1+ default) and Jackson. Ships
    an @AutoConfiguration so a CanonClient bean is wired straight
    from flycanon.* properties.
  </description>
  <url>https://github.com/fireflyframework/flycanon</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <organization>
    <name>Firefly Software Foundation</name>
    <url>https://github.com/fireflyframework</url>
  </organization>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      Spring Boot starter (brings spring-context, spring-boot,
      autoconfigure, Jackson, logging, ...). Pulled as ``compile`` so
      consumers that aren't already on Spring Boot still get
      everything the SDK needs to construct a CanonClient.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- RestClient + the rest of the spring-web sync HTTP stack. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <!--
      Reactive HTTP stack: WebClient + Reactor + Reactor Netty.
      Marked optional so consumers that only want the synchronous
      CanonClient don't pull the reactor / netty fat. To use the
      reactive variant (ReactiveCanonClient), add
      spring-boot-starter-webflux to your own pom; it brings both
      transitively.
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webflux</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.projectreactor.netty</groupId>
      <artifactId>reactor-netty-http</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      JSR-310 Jackson module so the SDK can round-trip Instant /
      OffsetDateTime payloads that the service emits.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <!--
      Annotation processor that emits IDE auto-complete metadata for
      flycanon.* properties when consumers depend on the SDK.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      WireMock for HTTP-level integration tests. We assert outbound
      headers (X-Tenant-Id, X-Workspace-Id, X-Correlation-Id,
      X-Agent-Token, Idempotency-Key, User-Agent) and exception
      dispatch by code via real HTTP round-trips against a stubbed
      server, so the SDK contract is verified end-to-end rather than
      via mocked clients.
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>3.9.1</version>
      <scope>test</scope>
    </dependency>
    <!--
      Reactor StepVerifier for the reactive variant's test suite.
      Brought in test-scope only so the published JAR stays free of
      io.projectreactor.test classpath entries.
    -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <release>${java.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!--
    GitHub Packages deploy target. The matching server entry
    (``<id>github</id>``) is provisioned by ``actions/setup-java``
    in ``.github/workflows/publish-sdks.yaml``; locally, install the
    same entry into ``~/.m2/settings.xml`` with your username + a
    personal access token (``read:packages``, ``write:packages``).
  -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages -- fireflyframework/flycanon</name>
      <url>https://maven.pkg.github.com/fireflyframework/flycanon</url>
    </repository>
  </distributionManagement>
</project>
